# Copie este archivo como .env.local. Nunca suba .env.local al repositorio.

# Supabase local: `npx supabase start` imprime estos dos valores.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (hitos 2 en adelante). Sin prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
