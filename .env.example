# Copie este archivo como .env.local. Nunca suba .env.local al repositorio.
# Sin las dos primeras variables, la app corre en modo demostración (sin inicio de sesión).

# Supabase: `npx supabase start` (local) o Project Settings → API (nube).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Sin prefijo NEXT_PUBLIC_.
# Texto largo al azar para el hash del límite de códigos (5 por hora por número o correo).
OTP_PEPPER=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Verify (los lee supabase/config.toml en local; en la nube se configuran en Supabase).
TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
